{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generate.diff: result",
  "type": "object",
  "properties": {
    "up_to_date": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unchanged",
              "changed",
              "added",
              "removed"
            ]
          },
          "diff": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Absolute path."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "description": "The node's path in the YAML, such as pins.usart2.tx; (root) for the document."
          }
        },
        "required": [
          "severity",
          "source",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "up_to_date",
    "files",
    "diagnostics",
    "errors",
    "warnings"
  ],
  "additionalProperties": false,
  "description": "Which generated files a generate would change, and how; nothing is written."
}
