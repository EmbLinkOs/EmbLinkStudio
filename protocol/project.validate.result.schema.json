{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project.validate: result",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Absolute path."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "description": "The node's path in the YAML, such as pins.usart2.tx; (root) for the document."
          }
        },
        "required": [
          "severity",
          "source",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "valid",
    "diagnostics",
    "errors",
    "warnings"
  ],
  "additionalProperties": false,
  "description": "The generator's verdict on the board and its SoC, every diagnostic located."
}
