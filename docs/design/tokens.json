{
  "name": "EmbLink Studio · dark",
  "version": 1,
  "about": "Design tokens for EmbLink Studio, taken from the mockups in docs/design/brief.md. The Qt frame reads these; nothing else defines a colour, a size, a timing or how text is laid out. Colours are sRGB hex, or rgba() for translucent layers drawn over the ground.",
  "color": {
    "surface": {
      "ground": {
        "value": "#111214",
        "use": "The window behind every card"
      },
      "titlebar": {
        "value": "#17181b",
        "use": "The title bar"
      },
      "card": {
        "value": "#1b1c20",
        "use": "Side panels, the inspector, the bottom panel"
      },
      "work": {
        "value": "#18191d",
        "use": "The centre card: editor, chip canvas, the run"
      },
      "canvas": {
        "value": "#15161a",
        "use": "Canvases, under a dot grid"
      },
      "deep": {
        "value": "#111214",
        "use": "Code, diffs and records inside a card"
      },
      "floating": {
        "value": "rgba(40,42,47,.97)",
        "use": "Toasts, menus, the command palette"
      }
    },
    "fill": {
      "group": {
        "value": "rgba(255,255,255,.035)",
        "use": "A group of settings rows inside a card"
      },
      "well": {
        "value": "rgba(0,0,0,.35)",
        "use": "Segmented-control tracks, search fields, inputs"
      },
      "readout": {
        "value": "rgba(0,0,0,.25)",
        "use": "Computed values and their tiles"
      },
      "control": {
        "value": "rgba(255,255,255,.08)",
        "use": "Secondary buttons"
      },
      "hover": {
        "value": "rgba(255,255,255,.045)",
        "use": "A row under the pointer"
      },
      "selected": {
        "value": "rgba(255,255,255,.075)",
        "use": "The selected row"
      },
      "segment": {
        "value": "#3d3f45",
        "use": "The chosen segment of a segmented control"
      },
      "segmentInGroup": {
        "value": "#4a4c53",
        "use": "The chosen segment inside a settings group"
      },
      "switchOff": {
        "value": "rgba(255,255,255,.14)",
        "use": "A switch that is off"
      },
      "grid": {
        "value": "rgba(255,255,255,.045)",
        "use": "Canvas dots, 1 px every 20 px"
      }
    },
    "line": {
      "hairline": {
        "value": "rgba(255,255,255,.05)",
        "use": "Separators inside a card"
      },
      "card": {
        "value": "rgba(255,255,255,.06)",
        "use": "The edge of a card"
      },
      "control": {
        "value": "rgba(255,255,255,.07)",
        "use": "The edge of an input"
      },
      "strong": {
        "value": "rgba(255,255,255,.1)",
        "use": "Floating surfaces"
      }
    },
    "text": {
      "strong": {
        "value": "#ffffff",
        "use": "Titles, the chosen segment"
      },
      "primary": {
        "value": "#e6e7ea",
        "use": "Body text"
      },
      "body": {
        "value": "#d6d8dc",
        "use": "Labels in settings rows"
      },
      "secondary": {
        "value": "#9a9ea7",
        "use": "Descriptions, unchosen segments"
      },
      "tertiary": {
        "value": "#80858e",
        "use": "Section captions, metadata"
      },
      "quiet": {
        "value": "#6f747d",
        "use": "Hints, footnotes"
      },
      "disabled": {
        "value": "#4d5058",
        "use": "Disabled text, power pins"
      },
      "onAccent": {
        "value": "#062430",
        "use": "Text on a cyan button"
      }
    },
    "accent": {
      "base": {
        "value": "#64d2ff",
        "use": "The one action colour: primary buttons, selection, focus"
      },
      "link": {
        "value": "#7cc4ff",
        "use": "Links and quiet actions"
      },
      "text": {
        "value": "#a8e4fb",
        "use": "Text on an accent tint"
      },
      "tint": {
        "value": "rgba(100,210,255,.14)",
        "use": "Accent backgrounds"
      }
    },
    "state": {
      "success": {
        "base": "#34c759",
        "text": "#7fe3a0",
        "tint": "rgba(52,199,89,.14)",
        "edge": "rgba(52,199,89,.35)",
        "use": "Passed, valid, connected, running"
      },
      "warning": {
        "base": "#e2b34f",
        "text": "#ecc985",
        "tint": "rgba(226,179,79,.1)",
        "edge": "rgba(226,179,79,.4)",
        "use": "A conflict, halted, a check to read"
      },
      "danger": {
        "base": "#f0736b",
        "text": "#f6b4ae",
        "tint": "rgba(240,115,107,.1)",
        "edge": "rgba(240,115,107,.35)",
        "use": "Failed, a fault, a rule broken"
      },
      "kernel": {
        "base": "#ffd60a",
        "text": "#ffe27a",
        "tint": "rgba(255,214,10,.14)",
        "edge": "rgba(255,214,10,.4)",
        "use": "Kernel-owned things: the tick, ceilings, the current line"
      }
    },
    "peripheral": {
      "uart": {
        "value": "#64d2ff",
        "use": "USART and UART"
      },
      "i2c": {
        "value": "#bf8cff",
        "use": "I2C"
      },
      "spi": {
        "value": "#ff6482",
        "use": "SPI"
      },
      "gpioOut": {
        "value": "#34c759",
        "use": "GPIO outputs, LEDs"
      },
      "gpioIn": {
        "value": "#66d4cf",
        "use": "GPIO inputs, buttons"
      },
      "adc": {
        "value": "#5e9cff",
        "use": "ADC and DAC"
      },
      "timer": {
        "value": "#ffd60a",
        "use": "Timers"
      },
      "debug": {
        "value": "#98989f",
        "use": "SWD, JTAG, trace"
      }
    },
    "syntax": {
      "text": {
        "value": "#d9dde3"
      },
      "keyword": {
        "value": "#c792ea"
      },
      "function": {
        "value": "#f5c97a"
      },
      "type": {
        "value": "#8cb4ff"
      },
      "macro": {
        "value": "#7fd3e8",
        "use": "EMB_ names and register fields"
      },
      "string": {
        "value": "#b5d98c"
      },
      "number": {
        "value": "#f2a36b"
      },
      "comment": {
        "value": "#646b77"
      }
    }
  },
  "type": {
    "family": {
      "ui": {
        "value": "Inter",
        "fallback": [
          "SF Pro Text",
          "system-ui"
        ]
      },
      "mono": {
        "value": "JetBrains Mono",
        "fallback": [
          "SF Mono",
          "Menlo"
        ]
      }
    },
    "scale": {
      "display": {
        "size": 24,
        "line": 30,
        "weight": 800,
        "tracking": "-0.01em",
        "use": "A board's name on Start"
      },
      "title1": {
        "size": 22,
        "line": 28,
        "weight": 700,
        "tracking": "-0.01em",
        "use": "A settings page"
      },
      "title2": {
        "size": 18,
        "line": 24,
        "weight": 700,
        "tracking": "-0.01em",
        "use": "The inspector's subject, a run"
      },
      "title3": {
        "size": 15,
        "line": 21,
        "weight": 700,
        "use": "A card's title"
      },
      "body": {
        "size": 13,
        "line": 19,
        "weight": 400,
        "use": "Everything by default"
      },
      "bodySmall": {
        "size": 12.5,
        "line": 18,
        "weight": 400,
        "use": "Settings labels, banners"
      },
      "small": {
        "size": 12,
        "line": 17,
        "weight": 400,
        "use": "Descriptions, status bars"
      },
      "meta": {
        "size": 11.5,
        "line": 16,
        "weight": 400,
        "use": "Second lines in lists"
      },
      "caption": {
        "size": 11,
        "line": 14,
        "weight": 600,
        "tracking": "0.05em",
        "case": "upper",
        "use": "Section captions"
      },
      "code": {
        "size": 12,
        "line": 18,
        "weight": 400,
        "family": "mono",
        "use": "Source, disassembly, memory: VS Code's metrics on macOS"
      },
      "codeMeta": {
        "size": 10.5,
        "line": 14,
        "weight": 400,
        "family": "mono",
        "use": "Keys, addresses, pin lines on cards"
      },
      "pin": {
        "size": 8.5,
        "line": 12,
        "weight": 400,
        "family": "mono",
        "use": "Pin names on the chip; 600 when the pin is in use"
      }
    }
  },
  "space": {
    "unit": 2,
    "scale": [
      2,
      4,
      6,
      8,
      10,
      12,
      14,
      16,
      20,
      24,
      28
    ],
    "gutter": 6,
    "cardPadding": [
      12,
      16
    ],
    "use": "Cards sit 6 px apart and 6 px from the window edge"
  },
  "radius": {
    "segment": 5,
    "control": 7,
    "button": 8,
    "track": 9,
    "group": 10,
    "card": 12,
    "window": 14,
    "pill": 999
  },
  "size": {
    "titlebar": 50,
    "cardHeader": 46,
    "editorHeader": 42,
    "statusbar": 32,
    "row": 32,
    "rowCompact": 24,
    "control": 26,
    "button": 30,
    "buttonLarge": 36,
    "switch": [
      36,
      21
    ],
    "dot": 7,
    "activityBar": 48,
    "codeLine": 18
  },
  "elevation": {
    "flat": {
      "value": "none",
      "use": "Cards: an edge, no shadow"
    },
    "raised": {
      "value": "0 8px 20px rgba(0,0,0,.38)",
      "use": "Cards on a canvas"
    },
    "selected": {
      "value": "0 0 0 4px <colour at 13%>, 0 14px 30px rgba(0,0,0,.5)",
      "use": "The selected card on a canvas"
    },
    "floating": {
      "value": "0 14px 34px rgba(0,0,0,.5)",
      "use": "Toasts, menus"
    },
    "window": {
      "value": "0 30px 80px rgba(0,0,0,.55)",
      "use": "Sheets and windows"
    },
    "knob": {
      "value": "0 1px 2px rgba(0,0,0,.4)",
      "use": "The chosen segment, a switch's knob"
    }
  },
  "motion": {
    "rule": "Motion lasts 200 to 400 ms, eases out, and starts where the cause is. Nothing loops unless it shows something live.",
    "hover": {
      "duration": 120,
      "easing": "linear",
      "use": "Row and button hover"
    },
    "state": {
      "duration": 200,
      "easing": "ease-out",
      "use": "Colours and fills changing: a switch, a segment, a status"
    },
    "enter": {
      "duration": 280,
      "easing": "ease-out",
      "offset": 5,
      "use": "Something new appears: it rises 5 px and fades in"
    },
    "move": {
      "duration": 350,
      "easing": "cubic-bezier(.2,.8,.2,1)",
      "use": "Something changes place: a thread to a new priority, a zoom"
    },
    "draw": {
      "duration": 300,
      "easing": "ease-out",
      "stagger": 280,
      "use": "A route draws itself, segment after segment"
    },
    "fill": {
      "duration": 400,
      "easing": "cubic-bezier(.2,.8,.2,1)",
      "use": "A bar or ring fills to a new value"
    },
    "stamp": {
      "duration": 550,
      "easing": "cubic-bezier(.2,.8,.2,1)",
      "use": "The hardware seal, and nothing else"
    },
    "live": {
      "duration": 2200,
      "easing": "ease-out",
      "loop": true,
      "use": "A connected board's pulse, a running target"
    }
  },
  "locale": {
    "rule": "The app ships in three languages. Every visible string comes from a Qt translation file (.ts, built with Qt Linguist); none is written into a layout. The language is chosen in Settings and applies without a restart.",
    "languages": {
      "value": [
        "en"
      ],
      "pending": "The owner names the other two; English is the source language."
    },
    "expansion": {
      "value": 1.35,
      "use": "Layouts leave room for text 35% longer than English. Labels never get a fixed width; they wrap or elide with the full text in a tooltip."
    },
    "neverTranslated": {
      "value": [
        "option keys (CONFIG_EMB_*)",
        "register and field names",
        "pin names",
        "file names and paths",
        "spec references (KRN-SCH-036)",
        "code"
      ],
      "use": "These stay as they are in every language, in the mono family."
    },
    "numbers": {
      "use": "Numbers, dates and units follow the chosen language (QLocale): 115,200 or 115 200. Hex values and addresses never change."
    }
  }
}
